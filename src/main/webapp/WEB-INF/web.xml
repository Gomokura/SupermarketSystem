        <url-pattern>/adminPromotion</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDeliveryServlet</servlet-name>
        <servlet-class>com.supermarket.servlet.AdminDeliveryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDeliveryServlet</servlet-name>
        <url-pattern>/adminDelivery</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminPurchaseServlet</servlet-name>
        <servlet-class>com.supermarket.servlet.AdminPurchaseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPurchaseServlet</servlet-name>
        <url-pattern>/adminPurchase</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminAuditServlet</servlet-name>
        <servlet-class>com.supermarket.servlet.AdminAuditServlet</servlet-class>
