<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Supermarket System</display-name>

    <!-- ==================== 数据库配置（全局初始化参数） ==================== -->
    <context-param>
        <param-name>db-url</param-name>
        <param-value>jdbc:oracle:thin:@127.0.0.1:1521:XE</param-value>
    </context-param>
    <context-param>
        <param-name>db-username</param-name>
        <param-value>system</param-value>
    </context-param>
    <context-param>
        <param-name>db-password</param-name>
        <param-value>123456</param-value>
    </context-param>
    <context-param>
        <param-name>db-driver</param-name>
        <param-value>oracle.jdbc.OracleDriver</param-value>
    </context-param>

    <!-- 文件上传临时目录 -->
    <context-param>
        <param-name>upload-dir</param-name>
        <param-value>/uploads</param-value>
    </context-param>

    <!-- ==================== Spring 容器监听器 ==================== -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:applicationContext.xml</param-value>
    </context-param>

    <!-- ==================== 编码过滤器 ==================== -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.supermarket.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==================== 登录过滤器 ==================== -->
    <filter>
        <filter-name>LoginFilter</filter-name>
        <filter-class>com.supermarket.filter.LoginFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoginFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>

    <!-- ==================== 角色权限过滤器 ==================== -->
    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.supermarket.filter.RoleFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>

    <!-- ==================== 文件上传过滤器 ==================== -->
    <filter>
        <filter-name>FileUploadFilter</filter-name>
        <filter-class>com.supermarket.filter.FileUploadFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FileUploadFilter</filter-name>
        <url-pattern>/upload.do</url-pattern>
    </filter-mapping>

    <!-- ==================== DispatchServlet（前端控制器） ==================== -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>com.supermarket.servlet.DispatchServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <!-- ==================== 欢迎页 ==================== -->
    <welcome-file-list>
        <welcome-file>index.do</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==================== 错误页面配置 ==================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/views/error/403.jsp</location>
    </error-page>

    <!-- ==================== Session 超时配置 ==================== -->
    <session-config>
        <session-timeout>120</session-timeout>
    </session-config>

</web-app>
