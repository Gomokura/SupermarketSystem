    </servlet>
    <servlet-mapping>
        <servlet-name>AdminOrderServlet</servlet-name>
        <url-pattern>/adminOrder</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminStatisticsServlet</servlet-name>
        <servlet-class>com.supermarket.servlet.AdminStatisticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminStatisticsServlet</servlet-name>
        <url-pattern>/adminStatistics</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminInventoryServlet</servlet-name>
        <servlet-class>com.supermarket.servlet.AdminInventoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
